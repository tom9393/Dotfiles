#!/bin/bash

KEY_FILE="/home/$USER/.gpg_key"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <file>"
    exit 1
fi

FILE="$1"

if [[ ! -f "$KEY_FILE" ]]; then
  echo "Error: Key '$KEY_FILE' does not exist."
  exit 1
fi

if [[ ! -f "$FILE" ]]; then
  echo "Error: File '$FILE' does not exist."
  exit 1
fi

KEY=$(cat "$KEY_FILE")

if [[ "$FILE" == *.gpg ]]; then
  OUT="${FILE%.gpg}"
  echo "🔓 Decrypting '$FILE' → '$OUT'..."
  gpg --batch --yes --passphrase "$KEY" -o "$OUT" -d "$FILE"
  if [[ $? -eq 0 ]]; then
    echo "✅ Decryption successful."
  else
    echo "❌ Decryption failed."
  fi
else
  OUT="${FILE}.gpg"
  echo "🔒 Encrypting '$FILE' → '${FILE}.gpg'..."
  gpg --symmetric --cipher-algo AES256 --batch --yes --passphrase "$KEY" -o "$OUT" "$FILE"
  if [[ $? -eq 0 ]]; then
    echo "✅ Encryption successful: ${FILE}.gpg"
  else
    echo "❌ Encryption failed."
  fi
fi
