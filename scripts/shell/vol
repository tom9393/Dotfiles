#!/bin/bash

if [[ $1 -gt 100 ]] || [[ $1 -lt 0 ]]; then
	echo "Volume must be between 0% and 100%"
	exit 1
fi

if command -v pactl &> /dev/null; then
	pactl set-sink-volume @DEFAULT_SINK@ $1%
	echo "Volume set to $1% using Pactl"
elif command -v amixer &> /dev/null; then
	amixer sset Master $1% &> /dev/null
	echo "Volume set to $1% using Amixer"
else
	echo "Could not find way to control sound"
	exit 1
fi
