# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Zsh stuff
get_home_with_hidden() {
	if [[ $1 == "f" ]]; then
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'bat --style=numbers --color=always --line-range :500 {}')
	else
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'tree -C {} | head -200')
	fi
}

goto_folder() {
	FOLDER=$(get_home_with_hidden d)
	if [[ -d $FOLDER ]]; then
		cd $FOLDER
		ls -lA
	fi
}

open_file() {
	FILE=$(get_home_with_hidden f)
	if [[ -e $FILE ]]; then
		if [[ $FILE =~ \.(png|jpg|jpeg)$ ]]; then
			echo $FILE
			kitten icat $FILE 2> /dev/null
		elif [[ $FILE =~ \.(doc|docx)$ ]]; then
			if command -v libreoffice &> /dev/null; then
				libreoffice $FILE &!
				kill $PPID
			else
				echo "Libreoffice not installed, aborting"
			fi
		elif [[ $FILE =~ (pdf)$ ]]; then
			if command -v firefox &> /dev/null; then
				firefox $FILE &!
				kill $PPID
			else
				echo "Firefox not installed"
			fi
		else
			$EDITOR $FILE
		fi
	fi
}

declare -A funs
funs[f]=open_file
funs[d]=goto_folder

finder() {
	echo
	echo "[D]irectories"
	echo "[F]iles"
	read -sk CHOICE
	if [[ -v funs[$CHOICE] ]]; then
		${funs[$CHOICE]}
	else
		echo
	fi
	zle accept-line
}

system_update() {
	OS=$(cat /etc/os-release | grep ^ID | tr -d ID=)
	if [[ $OS == "fedora" ]]; then
		sudo dnf upgrade -y
	else
		echo "Unknown OS"
	fi
}

open_editor() {
	$EDITOR
	zle accept-line
}

alias update=system_update

if command -v kitten &> /dev/null; then
	alias ssh="kitten ssh"
fi

zle -N finder
bindkey ^F finder

zle -N open_editor
bindkey '^ ' open_editor
source ~/powerlevel10k/powerlevel10k.zsh-theme

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
