# Zsh stuff

_git_status() {
	if [[ -d ".git" ]]; then
		git status
		zle accept-line
	fi
}

get_home_with_hidden() {
	if [[ $1 == "f" ]]; then
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'bat --style=numbers --color=always --line-range :500 {}')
	else
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'tree -C {} | head -200')
	fi
}

goto_folder() {
	FOLDER=$(get_home_with_hidden d)
	if [[ -d $FOLDER ]]; then
		cd $FOLDER
		ls -lA
	fi
	zle accept-line
}

fzf_editor() {
	FILE=$(get_home_with_hidden f)
	if [[ -e $FILE ]]; then
		$EDITOR $FILE
	fi
	zle accept-line
}

declare -A funs
funs[f]=fzf_editor
funs[d]=goto_folder

finder() {
	echo
	echo "D - directories"
	echo "F - files"
	read -sk CHOICE
	if [[ -v funs[$CHOICE] ]]; then
		${funs[$CHOICE]}
	else
		echo
	fi
	zle accept-line
}

system_update() {
	OS=$(cat /etc/os-release | grep ^ID | tr -d ID=)
	if [[ $OS == "fedora" ]]; then
		sudo dnf upgrade -y
	else
		echo "Unknown OS"
	fi
}

alias update=system_update


zle -N finder
bindkey ^F finder
