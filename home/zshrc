# Zsh stuff

_git_status() {
	if [[ -d ".git" ]]; then
		git status
		zle accept-line
	fi
}

get_home_with_hidden() {
	if [[ $1 == "f" ]]; then
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'bat --style=numbers --color=always --line-range :500 {}')
	else
		echo $({find ~ -not -path '*/.*' -type $1; find /home/$USER/.dotfiles -not -path '*/.git*' -type $1;} | fzf --preview 'tree -C {} | head -200')
	fi
}

goto_folder() {
	FOLDER=$(get_home_with_hidden d)
	if [[ -d $FOLDER ]]; then
		cd $FOLDER
		ls -lA
	fi
}

open_file() {
	FILE=$(get_home_with_hidden f)
	if [[ -e $FILE ]]; then
		if [[ $FILE =~ \.(png|jpg|jpeg)$ ]]; then
			echo $FILE
			kitten icat $FILE 2> /dev/null
		elif [[ $FILE =~ \.(doc|docx)$ ]]; then
			if command -v libreoffice &> /dev/null; then
				libreoffice $FILE &!
				kill $PPID
			else
				echo "Libreoffice not installed, aborting"
			fi
		else
			$EDITOR $FILE
		fi
	fi
}

declare -A funs
funs[f]=open_file
funs[d]=goto_folder

finder() {
	echo
	echo "D - directories"
	echo "F - files"
	read -sk CHOICE
	if [[ -v funs[$CHOICE] ]]; then
		${funs[$CHOICE]}
	else
		echo
	fi
	zle accept-line
}

system_update() {
	OS=$(cat /etc/os-release | grep ^ID | tr -d ID=)
	if [[ $OS == "fedora" ]]; then
		sudo dnf upgrade -y
	else
		echo "Unknown OS"
	fi
}

alias update=system_update

zle -N finder
bindkey ^F finder
