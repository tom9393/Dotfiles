# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
	source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Hide go path
export GOPATH=$HOME/.go

# .so path
export LD_LIBRARY_PATH=/usr/lib


# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
if [[ -d ~/powerlevel10k ]]; then
	source ~/powerlevel10k/powerlevel10k.zsh-theme
else
	git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/powerlevel10k && source ~/powerlevel10k/powerlevel9k.zsh-theme
fi

## Zsh stuff ##

PATHS=(-path "*/.*" -prune -o -path "*/node_modules*" -prune -o)
PATHS_ROOT=(-path "*/.*" -prune -o -path "*/node_modules*" -prune -o -path "/dev" -prune -o -path "/boot" -prune -o -path "/proc" -prune -o -path "/root" -prune -o -path "/sys" -prune -o)

get_path() {
	local type="$1"
	local base_dir="$2"
	shift 2  # Remove first two arguments, leaving only PATHS

	if [[ "$type" == "f" ]]; then
		find "$base_dir" "$@" -type f -print | fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'
	else
		find "$base_dir" "$@" -type d -print | fzf --preview 'tree -C {} | head -200'
	fi
}

goto_home() {
	FOLDER=$(get_path d "/home/$USER" "${PATHS[@]}")
	if [[ -d $FOLDER ]]; then
		cd $FOLDER || return
		ls -lA
		zle accept-line
	fi
}

goto_root() {
	FOLDER=$(get_path d "/" "${PATHS_ROOT[@]}")
	if [[ -d $FOLDER ]]; then
		cd $FOLDER || return
		ls -lA
		zle accept-line
	fi
}

open_file() {
	FILE=$(get_path f "/home/$USER" "${PATHS[@]}")
	if [[ -e $FILE ]]; then
		$EDITOR $FILE || return
	fi
}

system_update() {
	OS=$(cat /etc/os-release | grep ^ID | tr -d ID=)
	if [[ $OS == "fedora" ]]; then
		sudo dnf upgrade -y
	else
		echo "Unknown OS"
	fi
}

open_editor() {
	$EDITOR
	zle accept-line
}

alias update=system_update
alias ctlstatus="systemctl status"
alias ctlup="sudo systemctl start"
alias ctldown="sudo systemctl stop"

if command -v git &> /dev/null; then
	alias gcommit="git commit -m"
	alias gall="git add ."
	alias gpush="git push"
	alias gstatus="git status"
fi

# For whatever reason kitten breaks some ssh connections
#if command -v kitten &> /dev/null; then
#	alias ssh="kitten ssh"
#	alias icat="kitten icat"
#fi

if command -v flatpak &> /dev/null; then
	alias fupdate="flatpak update"
fi

zle -N open_file
bindkey ^F open_file

zle -N goto_home
bindkey ^G goto_home

zle -N goto_root
bindkey ^H goto_root

zle -N open_editor
bindkey '^ ' open_editor
