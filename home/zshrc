# Created by newuser for 5.9

_git_status() {
	if [[ -d ".git" ]]; then
		git status
		zle accept-line
	fi
}

path_no_git() {
	find $1 -not -path '*/.git*' -type $2
}

path_home_no_hidden() {
	find ~ -not -path '*/.*' -type $1
}

get_home_with_hidden() {
	echo $({path_home_no_hidden $1; path_no_git /home/$USER/.dotfiles $1;} | fzf)
}

goto_folder() {
	FOLDER=$(get_home_with_hidden d)
	if [[ -d $FOLDER ]]; then
		cd $FOLDER
		ls -lA
	fi
	zle accept-line
}

fzf_editor() {
	FILE=$(get_home_with_hidden f)
	if [[ -e $FILE ]]; then
		$EDITOR $FILE
	fi
	zle accept-line
}


zle -N fzf_editor
bindkey ^F fzf_editor

zle -N goto_folder
bindkey ^G goto_folder
