# Created by newuser for 5.9

_git_status() {
	if [[ -d ".git" ]]; then
		git status
		zle accept-line
	fi
}

open_editor() {
	$EDITOR
}

path_no_git() {
	find $1 -not -path '*/.git*' -type d
}

path_home_no_hidden() {
	find ~ -not -path '*/.*' -type d
}

goto_folder() {
	ME=$(echo $USER)
	FOLDER=$( {path_home_no_hidden; path_no_git /home/$USER/.dotfiles;} | fzf)
	if [[ -d $FOLDER ]]; then
		cd $FOLDER
		ls -lA
	fi
	zle accept-line
}


zle -N open_editor
bindkey ^F open_editor

zle -N goto_folder
bindkey ^G goto_folder
